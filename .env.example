APP_NAME="Demo NTT Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
APP_URL=https://demo-desa.nttdigital.site
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=daily
LOG_LEVEL=warning

# SQLite: cukup satu file, tidak perlu buat database MySQL. Data di-reset tiap malam.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/nttdigital-demo/database/demo.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Subdomain demo-{jenis}.DEMO_DOMAIN
DEMO_DOMAIN=nttdigital.site
DEMO_SITUS_UTAMA=https://nttdigital.site
DEMO_WHATSAPP=6282247290150
DEMO_ADMIN_PASSWORD=demo1234
